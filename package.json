{
  "name": "kmcp-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "KMCP citizen app — the public app drivers use to find a government car park, see what is free, and pay for a session.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run start --workspace @kmcp/citizen",
    "dev:local": "npm run dev:local --workspace @kmcp/citizen"
  },
  "engines": {
    "node": ">=22"
  }
}
